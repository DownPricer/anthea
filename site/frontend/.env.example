# Create React App (projet actuel)
# Dev local : backend FastAPI sur :8000. Prod Docker : laisser vide → same-origin /api.
REACT_APP_BACKEND_URL=http://localhost:8000
# Clé publique VAPID uniquement (jamais la privée ici)
REACT_APP_VAPID_PUBLIC_KEY=
# Statistique marketing landing (une seule source — ne pas hardcoder ailleurs)
REACT_APP_COMMUNITY_MEMBER_COUNT=5000

# Si migration Vite un jour :
# VITE_BACKEND_URL=
# VITE_VAPID_PUBLIC_KEY=

# Backend (générer une paire VAPID — JAMAIS exposer la privée au frontend)
