# Copier vers .env sur le VPS : cp .env.example .env && nano .env
#
# URL publique du site (sans slash final) — VAPID / métadonnées uniquement.
# L'API frontend en production utilise same-origin /api (nginx proxy).
PUBLIC_ORIGIN=https://fitgather.fr

# Secret JWT (ex. openssl rand -hex 32)
JWT_SECRET=remplacer_par_une_chaine_longue_secrete

MONGO_URL=mongodb://mongo:27017
DB_NAME=anthea

# Réseau Docker auquel est connecté « downpricer-nginx » (obligatoire).
# Le trouver avec :
#   docker inspect downpricer-nginx --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
EXTERNAL_PROXY_NETWORK=downpricer_default

# Web Push (VAPID) — générer une paire, ne jamais committer les vraies clés
# Frontend (build-time, clé publique uniquement) :
REACT_APP_VAPID_PUBLIC_KEY=
# Backend (runtime) :
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://fitgather.fr

# CORS explicite (jamais * avec credentials)
CORS_ORIGINS=https://fitgather.fr,https://www.fitgather.fr,https://anthea.sitereadyshd.fr,http://localhost:3000
COOKIE_SECURE=true

# URL publique (liens e-mail de vérification / reset)
PUBLIC_APP_URL=https://fitgather.fr

# SMTP OVH (ne jamais committer les secrets — uniquement dans .env sur le VPS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FitGather
SMTP_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# Catalogue exercices (ExerciseDB / AscendAPI)
# Import manuel uniquement — jamais au démarrage API :
#   python import_exercises.py --dry-run
#   python import_exercises.py --apply
#   python import_exercises.py --report
EXERCISE_PROVIDER=exercisedb
EXERCISE_PROVIDER_BASE_URL=https://oss.exercisedb.dev/api/v1
EXERCISE_PROVIDER_API_KEY=
EXERCISE_MEDIA_MODE=remote
# false = masque « créer un exercice personnalisé » (les customs historiques restent)
EXERCISE_CUSTOM_CREATION_ENABLED=false
